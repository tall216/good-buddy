{
  "expo": {
    "name": "Good Buddy",
    "slug": "good-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1a1a0a",
    "scheme": "goodbuddy",
    "ios": {
      "bundleIdentifier": "com.davidevans.goodbuddy",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Good Buddy uses your location to find other CB users nearby so you can talk to them. Your exact location is never shown to other users — only your approximate distance.",
        "NSMicrophoneUsageDescription": "Good Buddy needs the microphone to transmit your voice when you press and hold the Push-to-Talk button.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.davidevans.goodbuddy",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Good Buddy uses your location to find other CB users nearby so you can talk to them. Your exact location is never shown to other users — only your approximate distance."
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#ffa620"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71e68f85-4cd7-4449-b532-cac3bb1226fc"
      }
    },
    "owner": "runnercode"
  }
}

# Good Buddy — Supabase Config
# Copy this to .env and fill in your Supabase project values
# Get these from: Supabase Dashboard > Project Settings > API
#
# Expo inlines any var prefixed EXPO_PUBLIC_ into the client bundle at
# build time. Do NOT put the service_role/secret key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Audio relay server URL (deploy server/ to Railway/Render/Fly.io)
EXPO_PUBLIC_RELAY_URL=ws://localhost:8080
